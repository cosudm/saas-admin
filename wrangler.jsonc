{
  // IOS+ MCP Gateway Bridge — deploys over the existing `saas-admin` Worker
  // (same name + same D1 binding, so the connected Workers Builds pipeline just works).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iosmcp-db",
      "database_id": "771f3439-f3bc-41b3-b498-1f7fc2c4fa19"
    }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 6 2 * *"] },
  "vars": { "FINIX_WEBHOOK_SECRET": "" }
}
